{
  "name": "x-abuse-shield",
  "version": "0.2.0",
  "private": true,
  "description": "On-device multilingual abuse filter for x.com",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "release": "tsx scripts/release.ts",
    "release:publish": "tsx scripts/publish-release.ts",
    "postinstall": "node scripts/copy-ort.mjs && wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "wxt build && tsx scripts/e2e-smoke.ts",
    "test:e2e:firefox": "wxt build -b firefox && tsx scripts/e2e-smoke.ts --firefox",
    "test:e2e:hosted": "tsx scripts/e2e-smoke.ts --hosted",
    "spike:reference": "tsx scripts/spike-reference.ts",
    "spike:browser": "wxt build && tsx scripts/spike-browser.ts",
    "spike:report": "tsx scripts/spike-report.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "model:build": "tsx scripts/build-model.ts",
    "icons": "tsx scripts/build-icons.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "happy-dom": "21.0.4",
    "onnxruntime-node": "1.30.0",
    "puppeteer": "25.16.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
